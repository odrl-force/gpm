@prefix gpm:  <https://spec.knows.idlab.ugent.be/gpm/v0#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rml:  <http://w3id.org/rml/> .
@prefix :     <urn:example:> .

:mapping a rml:TriplesMap ;
  rml:logicalSource :view ;
  rml:subjectMap [
    rml:template "message_{#}" ;
    rml:termType rml:BlankNode ;
  ] ;
  rml:predicateObjectMap [
    rml:predicate gpm:client_id ;
    rml:objectMap [ rml:reference "client_id" ] ;
  # ], [
  #   rml:predicate gpm:scope ;
  #   rml:objectMap [ rml:reference "scope" ] ;
  # ], [
  #   rml:predicate gpm:resource ;
  #   rml:objectMap [ rml:reference "resource" ] ;
  ] .
