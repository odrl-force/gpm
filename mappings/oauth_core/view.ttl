@prefix gpm:  <https://spec.knows.idlab.ugent.be/gpm/v0#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rml:  <http://w3id.org/rml/> .
@prefix :     <urn:example:> .

:source a rml:RelativePathSource ;
  rml:root rml:CurrentWorkingDirectory ;
  rml:path "mappings/oauth_core/examples/minimal.jsonc" ;
.

:view a rml:LogicalView ;
  rml:viewOn [
    rml:source :source ;
    rml:referenceFormulation rml:JSONPath ;
    rml:iterator "$.[*]" ;
  ] ;
  rml:field [
    rml:fieldName "client_id" ;
    rml:reference "$.client_id" ;
  # ], [
